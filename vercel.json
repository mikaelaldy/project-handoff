{
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/playground",
      "dest": "api/playground.py"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
